# Merge into the existing local_settings.py; do not replace database/email config.
import os

DMOJ_TEST_UPLOAD_ROOT = '/test-uploads'
# Bridge and other app containers also load this file, but do not handle uploads.
DMOJ_TEST_UPLOAD_INTERNAL_SECRET = os.environ.get('TEST_UPLOAD_INTERNAL_SECRET', '')
DMOJ_TEST_UPLOAD_ENABLED = False  # Enable only after the staging acceptance checks.
DMOJ_TEST_UPLOAD_MAX_SIZE = 1024 ** 3  # 1 GiB per test-data ZIP; match tusd's -max-size.
DMOJ_TEST_UPLOAD_ACCEPT_NEW = True
# Nginx must overwrite this header in BOTH the upload proxy and location /:
#     uwsgi_param HTTP_X_FORWARDED_PROTO $scheme;
# tusd forwards the trusted header to its internal hook requests.
# This also prevents SECURE_SSL_REDIRECT from redirecting hooks to https://site.
SECURE_PROXY_SSL_HEADER = ('HTTP_X_FORWARDED_PROTO', 'https')
# tusd sends hooks through the existing internal HTTP listener, site:8000.
ALLOWED_HOSTS = [*ALLOWED_HOSTS, 'site']
# Verify the existing CELERY_BROKER_URL(_SECRET); use the existing Redis service.
